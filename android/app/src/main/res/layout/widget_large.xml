<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="RD SK · this week" android:textColor="#CCFFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/wl_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFD27A" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/wl_under" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="–" android:textColor="#FFFFFFFF" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="under review" android:textColor="#B3FFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/wl_wait" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="–" android:textColor="#FFFFFFFF" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="waiting on you" android:textColor="#B3FFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/wl_days" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="–" android:textColor="#FFFFFFFF" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="days to deadline" android:textColor="#B3FFFFFF" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" android:background="#33FFFFFF" />
    <TextView android:id="@+id/wl_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="12.5sp" />
    <TextView android:id="@+id/wl_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="12.5sp" />
    <TextView android:id="@+id/wl_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="12.5sp" />
    <TextView android:id="@+id/wl_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="12.5sp" />
    <TextView android:id="@+id/wl_deadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFD27A" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
